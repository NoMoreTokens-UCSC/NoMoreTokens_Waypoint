# Frontend environment variables
# Copy to .env.local for local development

# API base URL — set to your Docker or local API server
VITE_API_URL=http://localhost:8000/api/v1
# Optional: backend engineer supplies the public VAPID key for browser Web Push.
# Registration currently persists locally; configure the remote adapter before release.
# Never put a private key or credentials in a VITE_ variable.
VITE_WEB_PUSH_PUBLIC_KEY=
