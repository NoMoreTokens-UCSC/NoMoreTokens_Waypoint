# === Waypoint API — environment variables ===
# Copy this file to .env and fill in the values.

# --- Database ---
DATABASE_URL=postgresql+psycopg://waypoint:waypoint@db:5432/waypoint

# --- JWT ---
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE_MINUTES=480

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- File uploads ---
UPLOAD_DIR=/uploads

# --- Seeding ---
SEED_ON_START=true

# --- Data directory (CSV source files) ---
DATA_DIR=/data/General Data

# --- Business clock (demo only) ---
# "Today" for the demo. Defaults to one day before DEMO_DELIVERY_DATE.
# BUSINESS_DATE=2024-04-09
# The day to be planned. Must be is_operating=1, is_holiday=0 in calendar.csv.
DEMO_DELIVERY_DATE=2024-04-10
